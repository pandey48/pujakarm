PUJAPATH_ADMIN_PASSWORD=replace-with-a-strong-password
PUJAPATH_SESSION_SECRET=replace-with-at-least-32-random-characters
# Set to the canonical production origin when deploying (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.poojapath.com
# Optional: paste the token provided by Google Search Console for HTML-tag verification.
# GOOGLE_SITE_VERIFICATION=
# WhatsApp Cloud API notification settings (requires an approved template and opted-in recipient).
# Notifications default to the existing PujaPath WhatsApp contact (91 7389368597).
# Set WHATSAPP_NOTIFY_TO only if you want alerts delivered to a different number, digits only.
# Approve a template whose body has one text variable ({{1}}) to receive the enquiry details.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_NOTIFY_TO=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_GRAPH_API_VERSION=
# Optional absolute folder for enquiry JSON storage. Defaults to ./.data
# PUJAPATH_DATA_DIR=
